{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BackgroundJobs": {
    "Expiration": {
      "Enabled": true,
      "IntervalSeconds": 60
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPerMinute": 10,
    "RedeemPerMinute": 20
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpUser": "",
    "SmtpPassword": "",
    "EnableSsl": true,
    "From": "Drop <no-reply@drop.app>"
  },
  "Jwt": {
    "Issuer": "Drop",
    "Audience": "Drop.Mobile",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "Qr": {
    "PeriodSeconds": 30,
    "AcceptedPastSteps": 2
  },
  "Admin": {
    "Emails": []
  }
}
