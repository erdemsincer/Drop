# Copy to .env for `docker compose --profile api up --build`.
# Generate secrets with: openssl rand -base64 48

POSTGRES_PASSWORD=change-me
JWT_KEY=
QR_SIGNING_KEY=

# Any SMTP provider (Resend, SendGrid, Brevo, Mailgun...). Leave empty to disable e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Drop <no-reply@drop.app>

# Platform admins who approve businesses (comma-separated).
ADMIN_EMAILS=
